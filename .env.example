# Environment variables for AI Booking Assistant
# Copy this file to .env and fill in your values

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Gmail Configuration (for booking confirmations)
# GMAIL_USER: Your Gmail email address
# GMAIL_PASSWORD: App-specific password (NOT your Gmail password)
# Get app password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-specific-password-here

# Optional: Admin email for error notifications
# If not set, defaults to GMAIL_USER
ADMIN_EMAIL=admin@example.com

# Debug mode (set to false in production)
DEBUG_MODE=false
